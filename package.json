{
  "name": "northern-prologue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "fetch-sources": "node tools/fetch-sources.mjs && node tools/fetch-extra.mjs",
    "build-assets": "node tools/build-assets.mjs",
    "check-cave": "node tools/check-cave-mutations.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && node tools/check-lines.mjs && vite build",
    "preview": "node tools/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node tests/unit/run.mjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/loaders": "^9.29.0",
    "jolt-physics": "^1.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.7",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
